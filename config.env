# Math on the Edge: shared settings for the board scripts and the Python copilot.
# Bash sources this file, and copilot/config.py parses it. Keep it KEY=VALUE.
# Every team starts from the same pinned versions, so results are comparable.

# llama.cpp, pinned to a commit tested on the UNO Q 4 GB (November 2026)
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_CPP_REF=2cbe0ec429b849a88664e0f62388fc92a5abd699
LLAMA_CPP_DIR=~/llama.cpp

MODELS_DIR=~/models

# Teaching Copilot & Edge Champion model: Qwen3.5-0.8B-aqua-reason, Q8_0 (833 MB)
# Fine-tuned with AQuA (Algebraic Word Problems with Rationale) for Socratic reasoning
TEACHING_LLM_FILE=Qwen3.5-0.8B-aqua-reason-Q8_0.gguf
TEACHING_LLM_ALIAS=qwen3.5-0.8b-aqua-reason

# Language model: Qwen2.5-Math 1.5B Instruct, Q4_K_M (986 MB) - Arduino Champion
LLM_REPO=bartowski/Qwen2.5-Math-1.5B-Instruct-GGUF
LLM_REVISION=951ed2aea09c43e331c612e74d83e4a23ca98e3b
LLM_FILE=Qwen2.5-Math-1.5B-Instruct-Q4_K_M.gguf
LLM_SHA256=9614a50f03c897028920ca0dc4365da570bf587f9ee7768261216fe370b37e8e
LLM_ALIAS=qwen2.5-math-1.5b
# Alternative model: Qwen2.5-3B-Instruct, Q4_K_M (1.9 GB):
# LLM_REPO=bartowski/Qwen2.5-3B-Instruct-GGUF
# LLM_REVISION=main
# LLM_FILE=Qwen2.5-3B-Instruct-Q4_K_M.gguf
# LLM_SHA256=9c9f56a391a3abbd5b89d0245bf6106081bcc3173119d4229235dd9d23253f94
# LLM_ALIAS=qwen2.5-3b-instruct
# Previous model (Qwen3.5 0.8B, Q8_0, 835 MB):
# LLM_REPO=bartowski/Qwen_Qwen3.5-0.8B-GGUF
# LLM_REVISION=f36b1ea49a332ede8fe5f389bbf5b3575ef71f48
# LLM_FILE=Qwen_Qwen3.5-0.8B-Q8_0.gguf
# LLM_SHA256=7182e2362766bb9569209bbc24cf1a4cdfbb8ab161babdb2080c84fa62c08c2f
# LLM_ALIAS=qwen3.5-0.8b
LLM_PORT=8081
# One slot with 2048 tokens: fits problem + 1 example while saving RAM on 4 GB board
LLM_CTX=2048
# LLM_CTX=4096
LLM_THREADS=4
# Optional second server that can see images (see the Explorer section of the README)
VISION_PORT=8083

# Embedding model: bge-small-en-v1.5, Q8_0 (37 MB, 384 dimensions)
EMBED_REPO=CompendiumLabs/bge-small-en-v1.5-gguf
EMBED_REVISION=d32f8c040ea3b516330eeb75b72bcc2d3a780ab7
EMBED_FILE=bge-small-en-v1.5-q8_0.gguf
EMBED_SHA256=ec38e8da142596baa913124ae50550de284b6916bf59577ef2f0cb9660c2f514
EMBED_PORT=8082
# bge-small was trained on 512 tokens; longer problem texts are cut
EMBED_CTX=512
EMBED_THREADS=4
# bge-small expects this prefix on search queries, but not on stored documents
EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Official run rules
TIME_LIMIT_SECONDS=60
SEED=42
# Most common answer in M3Kang high_quality (D, 24.6%): used when a problem times out
FALLBACK_ANSWER=D

# Decision architecture settings
SOLVE_MODE=router
JEV_CONFIDENCE_THRESHOLD=0.38
COT_MAX_TOKENS=80
# Empirical training set debiasing (0.0 to disable, >0.0 to enable calibration)
DEBIAS_ALPHA=0.0
# Language Router settings
ROUTER_MATH_PORT=8081
ROUTER_MATH_URL=http://127.0.0.1:8081/v1/chat/completions
# English routing threshold: levels <= 5 routed to Qwen2.5-Math-1.5B, levels 6-7 routed to Qwen2.5-3B
ROUTER_ENG_MAX_LEVEL=5
RAG_NO_OPTIONS_K=5
RAG_NO_OPTIONS_MIN_SCORE=0.60
# Tier 0 RAG near-duplicate threshold for problems without options
TIER0_RAG_MIN_SCORE=0.94

